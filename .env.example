# Required: create a real key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Required: generate a unique value with at least 32 characters.
FLASK_SECRET_KEY=generate_a_secure_secret_here

# Optional local configuration
AIONEX_DATABASE_PATH=memory.db
AIONEX_LOCAL_USER_ID=local-user
AIONEX_CHAT_MODEL=gpt-4o-mini
AIONEX_TTS_MODEL=tts-1
AIONEX_MODERATION_MODEL=omni-moderation-latest
AIONEX_PORT=5000
AIONEX_DEBUG=false
AIONEX_LOG_LEVEL=INFO
